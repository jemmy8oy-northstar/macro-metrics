<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MacroMetrics.Services/MacroMetrics.Services.csproj" />
    <ProjectReference Include="../MacroMetrics.Abstractions/MacroMetrics.Abstractions.csproj" />
    <ProjectReference Include="../MacroMetrics.DataModels/MacroMetrics.DataModels.csproj" />
    <ProjectReference Include="../MacroMetrics.WebApi/MacroMetrics.WebApi.csproj" />
  </ItemGroup>

  <!-- Copy shared test fixtures from the repo root test-assets directory so they
       are available relative to the test output directory at runtime. -->
  <ItemGroup>
    <Content Include="..\..\test-assets\yfinance\*.json"
             CopyToOutputDirectory="PreserveNewest"
             Link="TestFixtures\yfinance\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>